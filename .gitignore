.atdd/reports/*.md

# Keep directory structure
!.atdd/requirements/.gitkeep
!.atdd/validation/.gitkeep
!.atdd/design/.gitkeep
!.atdd/scenarios/.gitkeep
!.atdd/refactoring/.gitkeep
!.atdd/reports/.gitkeep
